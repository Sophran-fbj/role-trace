# Public deployments are demo-only by default. Set to true only when you
# intentionally allow server-side real-model calls and accept their cost.
ENABLE_REAL_AI=false

# Choose openai (default) or deepseek. API keys must remain server-side only:
# never put them in NEXT_PUBLIC_* variables or commit a real value.
AI_PROVIDER=deepseek
# Request timeout in milliseconds for either provider.
AI_TIMEOUT_MS=20000

# OpenAI configuration. Select a model that supports Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# DeepSeek configuration. The base URL below is the official endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Allowed values: none, low, high, max. none is fastest.
DEEPSEEK_REASONING_EFFORT=none
