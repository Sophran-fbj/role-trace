# Choose openai (default) or deepseek. Keep every key server-side only.
AI_PROVIDER=openai
# Request timeout in milliseconds for either provider.
AI_TIMEOUT_MS=20000

# OpenAI configuration. Choose a model in your OpenAI project that supports Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# DeepSeek configuration. DEEPSEEK_BASE_URL defaults to https://api.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# none is fastest; allowed values: none, low, high, max.
DEEPSEEK_REASONING_EFFORT=none
